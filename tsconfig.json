{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "allowJs": true,
        "noEmit": true,
        "strict": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "types": []
    },
    "include": ["src"],
    "exclude": ["src/vendor"]
}
