{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "strict": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "types": [],
        "jsx": "react-jsx"
    },
    "include": ["src", "test/types"]
}
